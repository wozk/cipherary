
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About Cipherary';
const description = 'Discover Cipherary, an independent cybersecurity knowledge platform.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero">
        <p class="eyebrow">ABOUT CIPHERARY</p>

        <h1>
          A Knowledge Hub for<br />
          <span>Modern Cybersecurity.</span>
        </h1>

        <p class="intro">
          Cipherary is an independent knowledge platform
          that decodes cybersecurity, identity, and digital
          trust through clear explanations, practical insights,
          and real-world context.
        </p>

        <div class="terminal" aria-hidden="true">
          <div class="terminal-bar">
            <i></i><i></i><i></i>
          </div>
          <div class="terminal-text">
            &gt; cipherary<span>_</span>
          </div>
        </div>
      </section>

      <section class="information">
        <div class="info-block">
          <div class="icon">◇</div>
          <h2>Why Cipherary?</h2>
          <p>
            Cybersecurity can be complex and overwhelming.
            Cipherary breaks it down into understandable
            concepts, connects the dots between theory and
            practice, and helps you build a stronger
            foundation in the field.
          </p>
        </div>

        <div class="info-block">
          <div class="icon">◎</div>
          <h2>What You'll Find Here</h2>
          <ul>
            <li>Identity and Access Management (IAM)</li>
            <li>Privileged Access Security (PAM)</li>
            <li>Core cybersecurity concepts and fundamentals</li>
            <li>Practical guides, best practices, and insights</li>
          </ul>
        </div>
      </section>

      <section class="behind">
        <div class="icon">♙</div>
        <h2>Behind Cipherary</h2>
        <p>
          Cipherary is created and maintained by a cybersecurity
          professional with a focus on identity, access, and
          digital trust. The goal is to share knowledge,
          experience, and practical perspectives with the
          wider cybersecurity community.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  body {
    background: #080808;
    color: #f5f3ed;
    margin: 0;
  }
</style>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  .hero {
    position: relative;
    padding: 1rem 0 5rem;
    border-bottom: 1px solid #333;
  }

  .eyebrow {
    color: #ff873d;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.15;
    letter-spacing: -2px;
    margin: 1.5rem 0;
    color: #f5f3ed;
  }

  h1 span {
    color: #ff873d;
  }

  .intro {
    color: #b9c0cb;
    max-width: 580px;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .terminal {
    position: absolute;
    right: 0;
    top: 5rem;
    width: 280px;
    height: 145px;
    border: 2px solid #353535;
    border-radius: 12px;
    background: #050505;
    box-shadow: 0 0 65px #ff873d20;
  }

  .terminal-bar {
    display: flex;
    gap: 7px;
    padding: 14px;
    border-bottom: 1px solid #333;
  }

  .terminal-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .terminal-bar i:nth-child(2) {
    background: #ffbd2e;
  }

  .terminal-bar i:nth-child(3) {
    background: #28c840;
  }

  .terminal-text {
    padding: 24px 20px;
    font-family: monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .terminal-text span {
    color: #ff873d;
  }

  .information {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 4rem 0;
    border-bottom: 1px solid #333;
  }

  .info-block {
    min-width: 0;
  }

  .icon {
    color: #ff873d;
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  h2 {
    color: #f5f3ed;
    font-size: 1.65rem;
    margin: 0 0 1rem;
  }

  .info-block p,
  .behind p {
    color: #b9c0cb;
    line-height: 1.8;
    font-size: 1rem;
  }

  ul {
    padding-left: 1.3rem;
    color: #b9c0cb;
    line-height: 2;
  }

  li::marker {
    color: #ff873d;
  }

  .behind {
    padding: 4rem 0;
    max-width: 760px;
  }

  @media (max-width: 900px) {
    .terminal {
      position: relative;
      top: auto;
      right: auto;
      margin-top: 2rem;
      max-width: 100%;
    }
  }

  @media (max-width: 700px) {
    main {
      padding: 3rem 1.5rem;
    }

    .information {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h1 {
      letter-spacing: -1px;
    }
  }
</style>
