
---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav>
    <h2>
      <a class="brand" href="/cipherary/">{SITE_TITLE}</a>
    </h2>

    <div class="internal-links">
      <HeaderLink href="/cipherary/">Home</HeaderLink>
      <HeaderLink href="/cipherary/blog/">Blog</HeaderLink>
      <HeaderLink href="/cipherary/about/">About</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 2rem;
    background: #0b1018;
    border-bottom: 1px solid #252d38;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: auto;
    min-height: 76px;
  }

  h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .brand {
    color: #ff873d !important;
    font-weight: 800;
    text-decoration: none;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .internal-links :global(a) {
    color: #f5f3ed !important;
    text-decoration: none;
    font-weight: 600;
    padding: 1.5rem 0;
    border-bottom: 3px solid transparent;
  }

  .internal-links :global(a:hover) {
    color: #ff873d !important;
  }

  .internal-links :global(a.active) {
    color: #ff873d !important;
    border-bottom-color: #ff873d;
  }

  @media (max-width: 720px) {
    header {
      padding: 0 1rem;
    }

    nav {
      min-height: 65px;
    }

    h2 {
      font-size: 1.1rem;
    }

    .internal-links {
      gap: 1rem;
    }

    .internal-links :global(a) {
      font-size: 0.9rem;
    }
  }
</style>
